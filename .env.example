# Google Authentication Configuration
# Default path on Windows : C:\Users\<your-username>\AppData\Roaming\gcloud\application_default_credentials.json
# Default path on Mac : /Users/<your-username>/.config/gcloud/application_default_credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json

# Google Cloud Platform Configuration
GOOGLE_CLOUD_PROJECT=your-project-id

# https://docs.cloud.google.com/gemini-enterprise-agent-platform/machine-learning/general/locations#europe
GOOGLE_CLOUD_LOCATION=europe-west3

# Google Cloud Storage Configuration
GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name

# Use Gemini Enterprise Agent Platform (formerly Vertex AI) as the backend for google-genai, so no API key is required
GOOGLE_GENAI_USE_ENTERPRISE=TRUE

# Google Cloud Logging Configuration
GOOGLE_CLOUD_LOGGING_PROJECT=your-project-id

# Application Configuration
APP_NAME=agentic-ai-system
APP_ENV=development
APP_DEBUG=true

# Default agent to use when a connection starts
DEFAULT_AGENT_ID=greeting_agent

# Default LLM model for agents
DEFAULT_LLM_MODEL=gemini-3.5-flash

# Session backend: "VERTEX" for VertexAiSessionService, "IN_MEMORY" for InMemorySessionService.
# Defaults to "IN_MEMORY" locally, "VERTEX" on Cloud Run.
SESSION_BACKEND=IN_MEMORY

# Agent Runtime (Sessions + Memory Bank) and RAG Engine -- all optional.
# Region for Agent Runtime; defaults to GOOGLE_CLOUD_LOCATION.
# MEMORY_BANK_LOCATION=europe-west3
# Agent Runtime ID; auto-created on first start if empty.
# AGENT_ENGINE_ID=
# RAG corpus (projects/{project}/locations/{location}/ragCorpora/{id}); auto-created if empty.
# RAG_CORPUS=
# Embedding model for Memory Bank (gemini-embedding-2 is served via the "eu" multi-region).
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_LOCATION=eu
# Embedding model for a new RAG corpus (use text-multilingual-embedding-002 for non-English docs).
# RAG_EMBEDDING_MODEL=text-embedding-005

# Structured Logging (structlog)
# LOG_ENV is auto-detected: "console" locally, "gcp" on Cloud Run
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# OpenTelemetry → Cloud Trace
# ---------------------------------------------------------------------------
# Enable OTel trace export to Google Cloud Trace.
# Auto-enabled on Cloud Run; opt-in locally by setting to true.
# Requires `gcloud auth application-default login` and roles/cloudtrace.agent.
OTEL_ENABLED=false
# Sampling ratio (0.0 – 1.0). 1.0 = export every trace.
OTEL_TRACES_SAMPLER_RATIO=1.0

# Database Configuration (if needed)
DATABASE_URL=sqlite:///./app.db

